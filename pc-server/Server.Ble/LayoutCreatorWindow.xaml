<Window x:Class="BleServer.LayoutCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BleServer"
        Title="Controller layout creator"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="560"
        Background="#FF1E1E1E"
        PreviewKeyDown="LayoutCreatorWindow_OnPreviewKeyDown">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Preview -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Layout Preview"
                       FontSize="18"
                       Foreground="#FFF3F3F3"
                       Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1"
                       Text="Click to select, drag to move; drag bottom-right corner to resize (snaps to grid step)"
                       Foreground="#FFB0B0B0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <DockPanel Grid.Row="2" LastChildFill="True" Background="#FF4A4A54">
                <Viewbox Stretch="Uniform" Margin="4">
                    <Border Background="#FF0D0D0D" CornerRadius="28" Padding="12" Width="804" Height="384">
                        <Border Background="#FF121212" CornerRadius="18" ClipToBounds="True">
                            <Canvas x:Name="PreviewCanvas"
                                    Width="780" Height="360"
                                    Background="#FF1A1A1C"
                                    Cursor="Arrow"
                                    MouseLeftButtonDown="PreviewCanvas_OnMouseLeftButtonDown"
                                    MouseMove="PreviewCanvas_OnMouseMove"
                                    MouseLeftButtonUp="PreviewCanvas_OnMouseLeftButtonUp"
                                    MouseLeave="PreviewCanvas_OnMouseLeave"/>
                        </Border>
                    </Border>
                </Viewbox>
            </DockPanel>
        </Grid>

        <!-- Sidebar -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Layout Properties"
                       FontSize="18"
                       Foreground="#FFF3F3F3"
                       Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Layout name" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <TextBox x:Name="LayoutNameBox" Text="New layout" Margin="0,0,0,8"/>
                        <TextBlock Text="backgroundColor" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <local:HexColorPicker x:Name="LayoutBackgroundColorPicker"
                                              HexValue="FF1A1A1C"
                                              Margin="0,0,0,8"/>
                        <TextBlock Text="backgroundImage (URL or uploaded file)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LayoutBackgroundImageBox"
                                     Grid.Column="0"
                                     Height="32"
                                     Margin="0,0,8,0"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Hidden"
                                     VerticalScrollBarVisibility="Hidden"
                                     TextChanged="LayoutBackgroundImageBox_OnTextChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                                <Button MinWidth="72"
                                        Margin="0,0,0,4"
                                        Content="Upload..."
                                        Click="PickBackgroundImage_OnClick"/>
                                <Button MinWidth="72"
                                        Content="Clear"
                                        Click="ClearBackgroundImage_OnClick"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="BackgroundImageSourceHint"
                                   Foreground="#FF8E8E8E"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Resize grid size (logical px, 0 = off)"
                                   Foreground="#FFAAAAAA"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Name="ResizeGridSizeBox"
                                 Text="8"
                                 Margin="0,0,0,8"/>
                        <TextBlock Text="Steering target (tiltTarget)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TiltTargetCombo"
                                  Margin="0,0,0,8"
                                  PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                        <TextBlock Text="Step output (stepTarget)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StepTargetCombo"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,0"
                                  PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                    </StackPanel>

                    <Border Height="1"
                            Background="#FF555555"
                            Margin="0,4,0,12"/>
                    <TextBlock Text="Element settings"
                               FontSize="16"
                               Foreground="#FFF3F3F3"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
                        <TextBlock Text="Type (required)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TypeCombo"
                                Margin="0,0,0,8"
                                SelectionChanged="TypeCombo_OnSelectionChanged"
                                PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                        <TextBlock Text="Id (required)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="Label (required)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                        <StackPanel x:Name="JoystickFieldsPanel" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Text="joystickType (required)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                            <ComboBox Margin="0,0,0,0"
                                    ItemsSource="{Binding JoystickSideOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedItem="{Binding JoystickType, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                        </StackPanel>

                        <TextBlock Text="x (0–1, normalized)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                Value="{Binding X, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Text="y (0–1, normalized)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                Value="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                        <TextBlock Text="backgroundColor" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <local:HexColorPicker HexValue="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="color" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                        <local:HexColorPicker HexValue="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                        <StackPanel x:Name="ButtonFieldsPanel" Visibility="Collapsed">
                            <TextBlock Text="button shape" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                            <ComboBox Margin="0,0,0,8"
                                      ItemsSource="{Binding ButtonShapeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding ButtonShape, UpdateSourceTrigger=PropertyChanged}"
                                      PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                            <TextBlock Text="buttonValueMapping (bitmask) (required)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                            <ComboBox Margin="0,0,0,8"
                                    ItemsSource="{Binding ButtonIdMaskOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding ButtonId, UpdateSourceTrigger=PropertyChanged}"
                                    PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                            <TextBlock Text="image (URL or uploaded file)" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                        Text="{Binding ButtonImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        TextWrapping="NoWrap"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden"/>
                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                                    <Button MinWidth="72"
                                            Margin="0,0,0,4"
                                            Content="Upload..."
                                            Click="PickSelectedButtonImage_OnClick"/>
                                    <Button MinWidth="72"
                                            Content="Clear"
                                            Click="ClearSelectedButtonImage_OnClick"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ButtonImageHint}"
                                    Foreground="#FF8E8E8E"
                                    Margin="0,0,0,8"
                                    TextWrapping="Wrap"/>
                            <TextBlock Text="System Icon" Foreground="#FFAAAAAA" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SystemIconOptions, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    SelectedItem="{Binding UseSystemIcon, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="0,0,0,8"
                                    PreviewMouseWheel="ComboBox_PreviewMouseWheel"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="NoSelectionHint"
                               Text="Click an element in the preview to edit its properties"
                               Foreground="#FF666666"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Vertical">
                <Button Content="Add button" Margin="0,0,0,8" Click="AddButton_OnClick"/>
                <Button Content="Add joystick" Margin="0,0,0,8" Click="AddJoystick_OnClick"/>
                <Button Content="Remove selected element" Margin="0,0,0,8" Click="RemoveSelected_OnClick"/>
                <Button Content="Export JSON…" Margin="0,0,0,8" Click="ExportJson_OnClick"/>
                <Button Content="Send layout to phone" Margin="0,0,0,8" Click="SendLayoutToPhone_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
