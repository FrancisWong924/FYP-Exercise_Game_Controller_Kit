<UserControl x:Class="BleServer.TutorialOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Background="Transparent">
    <Grid x:Name="OverlayRoot"
          Background="Transparent"
          MouseLeftButtonDown="Overlay_OnMouseLeftButtonDown">
        <Path x:Name="SpotlightPath"
              Fill="#B3000000"
              IsHitTestVisible="False"/>
        <Canvas x:Name="MessageCanvas" IsHitTestVisible="False">
            <Border x:Name="MessagePanel"
                    Background="#FF2D2D30"
                    BorderBrush="#FF007ACC"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="16"
                    MaxWidth="380">
                <StackPanel>
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               Foreground="#FFF3F3F3"
                               FontSize="14"
                               LineHeight="20"/>
                    <TextBlock Text="Click anywhere to continue"
                               Foreground="#FF8E8E8E"
                               FontSize="11"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
