<Window x:Class="BleServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BLE Controller Server"
        Width="920" Height="640"
        MinWidth="640" MinHeight="420"
        Background="#FF1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Server"
                   FontSize="22"
                   Foreground="#FFF3F3F3"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1"
                Background="#FF252526"
                BorderBrush="#FF3F3F46"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <ScrollViewer x:Name="LogScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="LogText"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Foreground="#FFDCDCDC"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Stretch"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="LayoutCreatorButton"
                    Content="Controller layout creator..."
                    Padding="16,10"
                    MinWidth="220"
                    Click="LayoutCreatorButton_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
